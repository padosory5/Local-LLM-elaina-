{
  "description": "Multi-turn conversations exercising continuity state.",
  "measures": [
    "reference resolution",
    "correction accuracy",
    "active-goal continuity",
    "stale-context errors"
  ],
  "note": "Drives the real conversation_focus, TaskSessionStore and CapabilityOfferGate. The subject offered per turn is what the routing layer would supply; blank means the turn named nothing of its own, which is the case continuity has to cover.",
  "conversations": [
    {
      "id": "c01_cheaper",
      "kind": "short_term",
      "turns": [
        {
          "said": "I'm looking at keyboards.",
          "offered_subject": "keyboards",
          "subject": "keyboards"
        },
        {
          "said": "They're pricier than I expected.",
          "subject": "keyboards"
        },
        {
          "said": "Find me something cheaper.",
          "subject": "keyboards"
        }
      ],
      "note": "'something' inherits the standing subject"
    },
    {
      "id": "c02_pronoun_it",
      "kind": "short_term",
      "turns": [
        {
          "said": "I've been reading about the Framework laptop.",
          "offered_subject": "Framework laptop",
          "subject": "Framework laptop"
        },
        {
          "said": "Is it repairable?",
          "subject": "Framework laptop"
        },
        {
          "said": "How much does it cost?",
          "subject": "Framework laptop"
        }
      ]
    },
    {
      "id": "c03_deictic_there",
      "kind": "short_term",
      "turns": [
        {
          "said": "I'm moving to Seattle.",
          "offered_subject": "Seattle",
          "subject": "Seattle"
        },
        {
          "said": "Yep, I'm going there.",
          "subject": "Seattle"
        },
        {
          "said": "What's the rent like?",
          "subject": "Seattle"
        }
      ],
      "note": "a bare pointer names nothing; the focus stands"
    },
    {
      "id": "c04_correction_city",
      "kind": "correction",
      "turns": [
        {
          "said": "Find restaurants in Seoul.",
          "offered_subject": "restaurants in Seoul",
          "subject": "restaurants in Seoul"
        },
        {
          "said": "Actually, I meant Seattle.",
          "subject": "Seattle",
          "superseded": "restaurants in Seoul"
        },
        {
          "said": "Anything good near downtown?",
          "subject": "Seattle"
        }
      ],
      "note": "the corrected location replaces the stale one"
    },
    {
      "id": "c05_correction_no_i_mean",
      "kind": "correction",
      "turns": [
        {
          "said": "I'm moving to Seattle on the 18th.",
          "offered_subject": "Seattle",
          "subject": "Seattle"
        },
        {
          "said": "Do you know which university is there?",
          "offered_subject": "University of Washington",
          "subject": "University of Washington"
        },
        {
          "said": "Yep, I'm going there.",
          "subject": "University of Washington"
        },
        {
          "said": "No, I mean I'm going to UW.",
          "subject": "UW",
          "superseded": "University of Washington"
        }
      ],
      "note": "an explicit correction outranks the router's topic, and is taken VERBATIM -- the education alias table normalises an anchor ('I'm going to UW'), not a correction, because a correction is the most precise thing the person has said"
    },
    {
      "id": "c06_correction_not_x",
      "kind": "correction",
      "turns": [
        {
          "said": "Look up flights to Portland.",
          "offered_subject": "flights to Portland",
          "subject": "flights to Portland"
        },
        {
          "said": "Not Portland, I mean Seattle.",
          "subject": "Seattle",
          "superseded": "flights to Portland"
        }
      ]
    },
