# Secrets
.env
credentials*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Electron
desktop/node_modules/
desktop/dist/

# Generated runtime state
runtime/*.log
runtime/*-metrics.json
# Dogfood transcripts written by scripts/live_dogfood_conversation.py.
# Evidence for a measurement pass, regenerated by re-running it.
runtime/*_everyday.json
runtime/*_tooling.json
runtime/*_social.json
runtime/debug/
# What happened in each turn, from draft to speech (core/turn_trace.py),
# and the turns a stage rewrote. The person's own conversations.
runtime/turn_trace/
runtime/failure_bank/
runtime/data/visual_search_usage.json
# What she has learned about this person -- which track they meant,
# what they picked last time. Personal, and local by definition.
runtime/data/user_profile.json
runtime/agents/
runtime/audit/
runtime/secrets/

# Every browser-driver working profile lives directly under runtime/data/
# as its own directory (browser-profile, plus -probe/-recovery-<port>
# variants live tests spin up under other base names) -- only the two
# JSON files above belong to git. A whole Chromium profile (~100MB+ of
# cert lists, crash metadata, ad-block rules) was committed once under
# names this rule didn't cover; this pattern covers any base name so it
# can't happen again.
runtime/data/*/

# Everything she knows about you stays on this machine: her memory
# (SQLite + FAISS), the activity log, your recordings and start-up routine,
# your standing rules and the facts you asked her to keep.
runtime/database/
runtime/data/directives.yaml
runtime/data/about_me.yaml
runtime/data/routines/
runtime/data/*.db
# Where the machine was last time she started, so she can notice a move.
runtime/data/where_we_are.json
# Measurement runs that were never meant to be kept.
runtime/parity*.json

# Stray runtime dir some tools/ modules briefly wrote to before their
# path resolution was fixed to use core.paths (see browser_connection.py)
tools/runtime/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
