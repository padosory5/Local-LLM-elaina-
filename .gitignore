# Secrets
.env
credentials*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# Electron
desktop/node_modules/
desktop/dist/

# Generated runtime state
runtime/*.log
runtime/*-metrics.json
runtime/debug/
runtime/data/visual_search_usage.json
# What she has learned about this person -- which track they meant,
# what they picked last time. Personal, and local by definition.
runtime/data/user_profile.json
runtime/agents/
runtime/audit/
runtime/secrets/

# Every browser-driver working profile lives directly under runtime/data/
# as its own directory (browser-profile, plus -probe/-recovery-<port>
# variants live tests spin up under other base names) -- only the two
# JSON files above belong to git. A whole Chromium profile (~100MB+ of
# cert lists, crash metadata, ad-block rules) was committed once under
# names this rule didn't cover; this pattern covers any base name so it
# can't happen again.
runtime/data/*/

# Keep personal memory data local by default
runtime/database/*.db
runtime/database/*.index

# Stray runtime dir some tools/ modules briefly wrote to before their
# path resolution was fixed to use core.paths (see browser_connection.py)
tools/runtime/

# OS and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/
