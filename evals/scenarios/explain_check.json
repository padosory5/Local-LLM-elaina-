{
  "suite": "explain_check",
  "kind": "trajectory",
  "about": "The revised explanation contract's check (docs/EXPLANATION_CHECK.md): new first explanations, none from v1, Stage B, corpus v2 or Stage C's held-out set, each marked in advance with what a good answer needs. 'direct': a direct answer is the natural explanation and an example would be padding. 'example': the idea is abstract or the mechanism hard to picture, so an example genuinely helps. Loaded only by evals/explain_check.py.",
  "defaults": {
    "checks": {
      "not_searched": true,
      "no_cards": true
    }
  },
  "scenarios": [
    {"id": "xc_hiccups", "need": "direct", "language": "en", "domain": "biology", "source": "explanation check",
     "turns": [{"say": "Why do we hiccup?", "score": true, "mode": "cause",
                "checks": {"must_contain_any": ["diaphragm", "muscle", "spasm", "breath"]}}]},
    {"id": "xc_ocean_salty", "need": "direct", "language": "en", "domain": "geology", "source": "explanation check",
